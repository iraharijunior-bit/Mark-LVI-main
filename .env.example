# MIR AI — Environment Variables
# Copy this file to .env and fill in your values. Never commit real keys.

# OpenAI Compatible API (optional — app works with local fallback if not set)
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Or use any OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Alternative: Groq, Anthropic via OpenAI-compatible gateway, Together, etc.
# GROQ_API_KEY=gsk_xxx
# ANTHROPIC_API_KEY=sk-ant-xxx

# Netlify: no additional vars required for static mode.
# For Netlify Functions, set OPENAI_API_KEY in Netlify Dashboard > Site settings > Environment variables
